# Agrivio environment example
# Copy into an ignored local file (typically `.env.local` at the repository root
# and/or `apps/backend/.env.local`).
# Direct local backend start (`cd apps/backend && node index.js`) auto-loads `.env.local`
# via Node's built-in `process.loadEnvFile` before runtime validation.
# Existing process/CI environment variables are never overridden.
# Do not commit secrets. Do not expose server secrets to Angular.
#
# Note: Nx also loads workspace-root `.env*` into task processes. `PORT` here is the
# API listen port. Frontend serve pins `PORT=4200` via `apps/frontend/.env.serve` so
# `nx serve frontend` / `npm start` are not captured by the API port.

# Runtime mode (server only)
NODE_ENV=development
AGRIVIO_APP_PROFILE=local

# API listen binding (server only)
HOST=localhost
PORT=3000

# MongoDB connection (server only; required outside test profile)
# Local single-node replica-set development contract:
#   host: 127.0.0.1
#   port: 27017
#   database: Agrivio
#   replica set: rs0
# Standalone mongod is not supported (transactions require rs0).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=Agrivio
MONGODB_REPLICA_SET=rs0

# Session secret (server only; required outside test; min 32 chars for non-test)
# Never commit a real secret. Generate a local value, for example in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
SESSION_SECRET=replace-with-a-long-local-development-secret-at-least-32-chars

# Optional: skip auto-loading `.env.local` (CI/scripts)
# AGRIVIO_SKIP_ENV_FILE=true

# Test-only switches — do not enable for normal local/production runs
# AGRIVIO_SKIP_MONGO is only permitted when NODE_ENV=test (memory persistence)
# AGRIVIO_SKIP_MONGO=true
# AGRIVIO_ALLOW_E2E_BOOTSTRAP enables POST /api/v1/test/e2e/bootstrap (impossible in production)
# AGRIVIO_ALLOW_E2E_BOOTSTRAP=true

# Browser-safe public web configuration only (Angular compile-time / docs)
# Development API contract: Angular (http://localhost:4200 by default, or another
# loopback port such as 4400) → http://localhost:3000/api/v1/* with credentialed
# CORS. Credentials are never allowed from arbitrary origins (no wildcard CORS).
AGRIVIO_PUBLIC_API_BASE_URL=http://localhost:3000
# Browser origin used for Owner activation URLs and the explicit CORS allowlist.
# Development also allows http(s) loopback (localhost / 127.0.0.1) on any port so
# `nx serve frontend --port=4400` works when 4200 is occupied. Production never
# auto-allows loopback; set this to the real frontend origin.
AGRIVIO_PUBLIC_WEB_BASE_URL=http://localhost:4200
# Optional extra explicit origins (comma-separated). Never use * or null.
# AGRIVIO_ALLOWED_ORIGINS=https://app.example.com

# Password-reset mail (server only). Local/dev may omit AGRIVIO_SMTP_HOST (reset still
# succeeds with a generic response; no email is sent). Production requires host + from.
AGRIVIO_SMTP_HOST=smtp.example.com
AGRIVIO_SMTP_PORT=587
AGRIVIO_SMTP_SECURE=false
AGRIVIO_SMTP_USERNAME=smtp-user
AGRIVIO_SMTP_PASSWORD=replace-with-smtp-password
AGRIVIO_SMTP_FROM=noreply@example.com

# Playwright E2E origins (optional; defaults shown)
AGRIVIO_E2E_API_ORIGIN=http://127.0.0.1:3100
AGRIVIO_E2E_WEB_ORIGIN=http://127.0.0.1:4300

# MongoDB Database Tools paths (optional; resolved from PATH if unset)
# Install: https://www.mongodb.com/try/download/database-tools
# AGRIVIO_MONGODUMP_PATH=C:\Program Files\MongoDB\Tools\100\bin\mongodump.exe
# AGRIVIO_MONGORESTORE_PATH=C:\Program Files\MongoDB\Tools\100\bin\mongorestore.exe

# Production backup destination (required for ops:backup / ops:restore CLI)
# Must be an absolute path outside the web/Express static root.
# On Windows example: AGRIVIO_BACKUP_DIR=C:\AgrivioBackups
# AGRIVIO_BACKUP_DIR=

# Backup retention: number of days to retain archives (0 or unset = keep all)
# AGRIVIO_BACKUP_RETENTION_DAYS=30

# Optional native mongod config path (Windows helper script)
# AGRIVIO_MONGOD_CFG=

# Super Admin bootstrap CLI (never commit a real password)
# AGRIVIO_BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# CI
# CI=true
