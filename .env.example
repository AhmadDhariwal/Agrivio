# Agrivio environment example
# Copy values into ignored local files (.env.local / .env.test) as needed.
# Do not commit secrets. Do not expose server secrets to Angular.

# Runtime mode (server only)
NODE_ENV=development
AGRIVIO_APP_PROFILE=local

# API listen binding (server only)
HOST=localhost
PORT=3000

# MongoDB connection (server only; validated in F00, wired in later F00 items)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=agrivio_dev
MONGODB_REPLICA_SET=rs0

# Session secret (server only; replace for non-test profiles; never log the value)
SESSION_SECRET=replace-with-a-long-local-development-secret

# Browser-safe public web configuration only
AGRIVIO_PUBLIC_API_BASE_URL=http://localhost:3000
