{
  "extends": "@agrivio/tooling-config/typescript/node.json",
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "vitest.config.mts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.js"]
}
