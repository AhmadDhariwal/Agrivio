{
  "name": "@agrivio/source",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "nx": "nx",
    "start": "nx run-many -t serve -p frontend,backend --parallel=2",
    "dev": "nx run-many -t serve -p frontend,backend --parallel=2",
    "dev:frontend": "nx serve frontend",
    "dev:backend": "nx serve backend",
    "build": "nx run-many -t build --all",
    "build:frontend": "nx build frontend",
    "build:backend": "nx build backend",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "npm run test:unit",
    "test:unit": "nx run-many -t test --all",
    "test:integration": "nx run test-support:test-integration",
    "test:architecture": "node scripts/run-architecture-tests.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "test:regression:release": "node scripts/run-regression.mjs --release",
    "e2e": "playwright test",
    "test:perf:baseline": "node scripts/f09-performance-baseline.mjs",
    "test:perf:navigation": "playwright test f09-perf-navigation",
    "test:a11y:baseline": "playwright test f09-accessibility f09-a11y-shell f09-a11y-workflows f09-a11y-contrast",
    "test:ops:rehearsal": "node scripts/ops/f09-backup-restore-import-rehearsal.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:architecture && npm run build",
    "affected:check": "nx affected -t lint,typecheck,test,build",
    "db:up": "node scripts/mongodb/up.mjs",
    "db:init": "node scripts/mongodb/init.mjs",
    "db:status": "node scripts/mongodb/status.mjs",
    "db:configure-native": "node scripts/mongodb/configure-native-windows.mjs",
    "db:logs": "node scripts/mongodb/logs.mjs",
    "db:down": "node scripts/mongodb/down.mjs",
    "db:reset": "node scripts/mongodb/reset.mjs",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs",
    "seed:demo": "node scripts/seed-demo-dataset.mjs"
  },
  "dependencies": {
    "@agrivio/api-contracts": "*",
    "@agrivio/test-support": "*",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "argon2": "0.41.1",
    "chart.js": "4.5.1",
    "express": "5.2.1",
    "mongoose": "8.15.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@agrivio/tooling-config": "*",
    "@angular-devkit/core": "22.0.8",
    "@angular-devkit/schematics": "22.0.8",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/language-service": "22.0.8",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/esbuild": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/express": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@playwright/test": "1.62.0",
    "@schematics/angular": "22.0.8",
    "@swc/helpers": "0.5.23",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/utils": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "esbuild": "0.27.7",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.1.0",
    "prettier": "3.9.6",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@babel/helper-define-polyfill-provider": "0.6.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "less@4.5.1": true,
    "less@4.8.1": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.1.0": true,
    "unrs-resolver@1.12.2": true,
    "argon2": false
  }
}
