{
  "name": "@agrivio/source",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many -t serve -p frontend,backend --parallel=2",
    "dev:frontend": "nx serve frontend",
    "dev:backend": "nx serve backend",
    "build": "nx run-many -t build --all",
    "build:frontend": "nx build frontend",
    "build:backend": "nx build backend",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "pnpm test:unit",
    "test:unit": "nx run-many -t test --all",
    "test:integration": "nx run test-support:test-integration",
    "test:architecture": "node scripts/run-architecture-tests.mjs",
    "e2e": "node scripts/deferred-command.mjs e2e R1-F00-009",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:architecture && pnpm build",
    "affected:check": "nx affected -t lint,typecheck,test,build",
    "db:up": "node scripts/mongodb/up.mjs",
    "db:init": "node scripts/mongodb/init.mjs",
    "db:status": "node scripts/mongodb/status.mjs",
    "db:logs": "node scripts/mongodb/logs.mjs",
    "db:down": "node scripts/mongodb/down.mjs",
    "db:reset": "node scripts/mongodb/reset.mjs"
  },
  "dependencies": {
    "@agrivio/api-contracts": "workspace:*",
    "@agrivio/test-support": "workspace:*",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "express": "5.2.1",
    "mongoose": "8.15.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@agrivio/tooling-config": "workspace:*",
    "@angular-devkit/core": "22.0.8",
    "@angular-devkit/schematics": "22.0.8",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@angular/language-service": "22.0.8",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/esbuild": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/express": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@schematics/angular": "22.0.8",
    "@swc/helpers": "0.5.23",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/utils": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "esbuild": "0.27.7",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.1.0",
    "prettier": "3.9.6",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
