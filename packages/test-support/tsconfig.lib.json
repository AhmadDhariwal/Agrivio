{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.integration.spec.ts",
    "src/integration/**"
  ]
}
